---
import BaseLayout from "../layouts/BaseLayout.astro";

const topNotchBreakfastMapsUrl = "https://www.google.com/maps/search/?api=1&query=Top%20Notch%20Breakfast%20Restaurant%2C%2010171%20Highway%206%2C%20Wiarton%2C%20Ontario";
const topNotchBreakfastPhone = "tel:+15195341310";

const restaurantPhotos = {
  hero: "/images/breakfast/restaurant/hero.webp",
  atmosphere: "/images/breakfast/restaurant/atmosphere.webp",
  booths: "/images/breakfast/restaurant/booths.webp",
  groups: "/images/breakfast/restaurant/groups.webp",
  retroCars: "/images/breakfast/restaurant/retro-cars.webp",
  historySign: "/images/breakfast/restaurant/history-sign.webp",
};

const menuArtwork = [
  {
    src: "/images/breakfast/menu/start-your-day.webp",
    alt: "Top Notch Breakfast Restaurant breakfast menu with house specials, omelettes, pancakes, French toast, sandwiches, sides and beverages",
    label: "Breakfast Menu",
  },
  {
    src: "/images/breakfast/menu/perfect-for-lunch.webp",
    alt: "Top Notch Breakfast Restaurant lunch menu with appetizers, soups, salads, sandwiches and wraps",
    label: "Lunch Menu",
  },
  {
    src: "/images/breakfast/menu/burgers-and-more.webp",
    alt: "Top Notch Breakfast Restaurant menu with burgers, hot sandwiches, children's menu, desserts and beverages",
    label: "Burgers & More",
  },
];

const breakfastMenuSections = [
  {
    title: "House Specials",
    items: [
      ["Eggs Benedict", "$13.99"],
      ["Hungry Man Breakfast", "$14.25"],
      ["Top Notch Breakfast", "$14.25"],
      ["2 Egg Breakfast", "$10.99"],
      ["2 Eggs with Peameal Bacon", "$12.99"],
      ["1 Egg Breakfast", "$10.45"],
      ["1 Egg with Peameal Bacon", "$12.45"],
    ],
  },
  {
    title: "Omelettes",
    items: [
      ["Greek", "$14.99"],
      ["Cheese", "$13.99"],
      ["Vegetarian", "$14.99"],
      ["Special", "$14.99"],
    ],
  },
  {
    title: "Pancakes & French Toast",
    items: [
      ["Pancakes", "$9.99"],
      ["Pancakes with Bacon, Ham or Sausage", "$12.50"],
      ["French Toast", "$9.99"],
      ["French Toast with Bacon, Ham or Sausage", "$12.50"],
    ],
  },
  {
    title: "Breakfast Sandwiches & Toast",
    items: [
      ["Breakfast Western Sandwich", "$12.50"],
      ["Breakfast Sandwich", "$12.50"],
      ["Fried Egg Sandwich", "$9.75"],
      ["Toast and Jam", "$2.99"],
      ["Rye or Multigrain Toast and Jam", "$3.45"],
      ["Gluten-Free Toast and Jam", "$3.99"],
    ],
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    name: "Top Notch Breakfast Restaurant",
    url: "https://wiartonwillys.com/breakfast",
    telephone: "+1-519-534-1310",
    image: "https://wiartonwillys.com/images/breakfast/restaurant/hero.webp",
    servesCuisine: ["Breakfast", "Canadian", "Homestyle"],
    address: {
      "@type": "PostalAddress",
      streetAddress: "10171 Highway 6",
      addressLocality: "Wiarton",
      addressRegion: "ON",
      addressCountry: "CA",
    },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "08:00",
        closes: "14:00",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Wiarton Willys Inn",
        item: "https://wiartonwillys.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Breakfast",
        item: "https://wiartonwillys.com/breakfast",
      },
    ],
  },
];
---

<BaseLayout
  title="Breakfast in Wiarton | Top Notch Breakfast Restaurant"
  description="Discover Top Notch Breakfast Restaurant in Wiarton: homestyle breakfast, booths, group seating and a full breakfast-and-lunch menu. Open daily 8:00 AM–2:00 PM."
  canonicalPath="/breakfast"
  image={restaurantPhotos.hero}
  schema={schema}
  pageType="breakfast"
  hideMobileStickyCTA={true}
>
  <section class="breakfast-hero">
    <img
      class="breakfast-hero__image"
      src={restaurantPhotos.hero}
      alt="Warm wood dining room inside Top Notch Breakfast Restaurant in Wiarton"
      width="1400"
      height="788"
      fetchpriority="high"
      decoding="async"
    />
    <div class="breakfast-hero__shade"></div>
    <div class="container breakfast-hero__content">
      <p class="eyebrow">Top Notch Breakfast Restaurant</p>
      <span class="breakfast-hero__badge">Open Daily • 8:00 AM–2:00 PM</span>
      <h1>Start Your Day With a Proper Breakfast.</h1>
      <p class="lead">
        A warm, old-school Wiarton breakfast spot with wood booths, mismatched stained-glass lights and the kind of atmosphere you only get from a long-standing local restaurant.
      </p>

      <div class="breakfast-hero__facts">
        <a href={topNotchBreakfastMapsUrl} target="_blank" rel="noopener noreferrer" data-track="top-notch-breakfast-directions">
          10171 Highway 6, Wiarton
        </a>
        <a href={topNotchBreakfastPhone} data-track="call">(519) 534-1310</a>
      </div>

      <div class="button-row">
        <a class="btn btn-primary" href="#menu">See the Menu</a>
        <a class="btn btn-secondary breakfast-hero__button" href={topNotchBreakfastMapsUrl} target="_blank" rel="noopener noreferrer" data-track="top-notch-breakfast-directions">Get Directions</a>
      </div>

      <p class="breakfast-hero__note">
        Recommended for Wiarton Willys Inn guests. Top Notch Breakfast Restaurant is a separate business.
      </p>
    </div>
  </section>

  <section class="section breakfast-story">
    <div class="container breakfast-story__grid">
      <div class="breakfast-story__copy">
        <p class="eyebrow">This Is Top Notch</p>
        <h2>Warm, Woody, Retro — and Actually Memorable.</h2>
        <p class="lead">
          From the road, you might not guess what is waiting inside. Step through the door and it feels completely different: lots of natural wood, vintage details, stained-glass pendant lights and a comfortable local-diner feel.
        </p>
        <p>
          It is the kind of place that works for a quick breakfast before heading north, a slow morning with coffee, or a full family meal before a Bruce Peninsula day trip.
        </p>
      </div>

      <figure class="breakfast-photo breakfast-photo--large">
        <img
          src={restaurantPhotos.atmosphere}
          alt="Top Notch dining room with wood tables, colourful pendant lights and retro details"
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section-tight breakfast-features">
    <div class="container">
      <div class="section-heading breakfast-features__heading">
        <p class="eyebrow">More Than a Quick Bite</p>
        <h2>A Real Sit-Down Breakfast Stop.</h2>
        <p class="lead">Private booths, room for groups, and plenty of character.</p>
      </div>

      <div class="breakfast-feature-grid">
        <article class="breakfast-feature">
          <img src={restaurantPhotos.booths} alt="Wood booth seating at Top Notch Breakfast Restaurant" width="1100" height="619" loading="lazy" decoding="async" />
          <div>
            <p class="eyebrow">Cozy Booths</p>
            <h3>Settle In.</h3>
            <p>Classic wood booths give couples, families and regulars a comfortable place to sit down and enjoy breakfast properly.</p>
          </div>
        </article>

        <article class="breakfast-feature">
          <img src={restaurantPhotos.groups} alt="Large group dining room at Top Notch Breakfast Restaurant" width="1200" height="675" loading="lazy" decoding="async" />
          <div>
            <p class="eyebrow">Groups Welcome</p>
            <h3>Room for the Whole Crew.</h3>
            <p>The second dining room gives larger families and groups space to eat together without making the restaurant feel cramped.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section breakfast-character">
    <div class="container breakfast-character__grid">
      <figure class="breakfast-photo breakfast-character__retro">
        <img src={restaurantPhotos.retroCars} alt="Collection of vintage model cars inside Top Notch Breakfast Restaurant" width="1100" height="619" loading="lazy" decoding="async" />
      </figure>

      <div class="breakfast-character__copy">
        <p class="eyebrow">A Little Different</p>
        <h2>The Retro Details Are Part of the Place.</h2>
        <p class="lead">
          The model cars, old decor and collected pieces are not staged restaurant props. They are part of what gives Top Notch its personality.
        </p>
        <p>
          We would rather keep that character than turn the place into another generic modern dining room.
        </p>
      </div>

      <figure class="breakfast-photo breakfast-character__history">
        <img src={restaurantPhotos.historySign} alt="Handmade Top Notch Motel Restaurant sign and local artwork" width="1100" height="619" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section breakfast-menu" id="menu">
    <div class="container">
      <div class="section-heading breakfast-menu__heading">
        <p class="eyebrow">The Menu</p>
        <h2>Breakfast Classics, Made to Order.</h2>
        <p class="lead">
          Eggs, peameal bacon, omelettes, pancakes, French toast and the familiar breakfast favourites you actually want before a full day out.
        </p>
      </div>

      <div class="breakfast-menu-grid">
        {breakfastMenuSections.map((section) => (
          <article class="breakfast-menu-card">
            <h3>{section.title}</h3>
            <ul>
              {section.items.map(([name, price]) => (
                <li>
                  <span>{name}</span>
                  <strong>{price}</strong>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="breakfast-menu-note">
        <strong>Toast choices:</strong> White, Brown, Rye (+$1), Multigrain (+$1), Gluten-Free (+$1.50).
        Menu items and pricing can change; the artwork below reflects the current restaurant menu.
      </div>
    </div>
  </section>

  <section class="section breakfast-artwork">
    <div class="container">
      <div class="section-heading breakfast-artwork__heading">
        <p class="eyebrow">Full Menu Artwork</p>
        <h2>Breakfast, Lunch, Burgers & More.</h2>
        <p class="lead">Tap any menu page to open it full size on your phone.</p>
      </div>

      <div class="breakfast-artwork__grid">
        {menuArtwork.map((menu) => (
          <a class="breakfast-menu-poster" href={menu.src} target="_blank" rel="noopener noreferrer" aria-label={"Open " + menu.label + " full size"}>
            <img src={menu.src} alt={menu.alt} loading="lazy" decoding="async" />
            <span>{menu.label} <b>Open full size →</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight breakfast-gallery">
    <div class="container">
      <div class="section-heading breakfast-gallery__heading">
        <p class="eyebrow">Inside Top Notch</p>
        <h2>Not Much Like It From the Outside.</h2>
        <p class="lead">That is exactly why it is worth walking in.</p>
      </div>

      <div class="breakfast-gallery__grid" aria-label="Top Notch Breakfast Restaurant photo gallery">
        <img src={restaurantPhotos.atmosphere} alt="Main dining room at Top Notch Breakfast Restaurant" loading="lazy" decoding="async" />
        <img src={restaurantPhotos.booths} alt="Wood booth seating inside Top Notch Breakfast Restaurant" loading="lazy" decoding="async" />
        <img src={restaurantPhotos.retroCars} alt="Vintage model car display inside Top Notch Breakfast Restaurant" loading="lazy" decoding="async" />
        <img src={restaurantPhotos.groups} alt="Large group dining area inside Top Notch Breakfast Restaurant" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section breakfast-location">
    <div class="container breakfast-location__card">
      <div>
        <p class="eyebrow">Easy Stop in Wiarton</p>
        <h2>10171 Highway 6</h2>
        <p class="lead">
          Have breakfast before heading toward Tobermory, Sauble Beach, Bruce's Caves or anywhere else around the peninsula.
        </p>
        <div class="breakfast-location__details">
          <span><strong>Hours:</strong> 8:00 AM–2:00 PM daily</span>
          <span><strong>Phone:</strong> (519) 534-1310</span>
        </div>
        <p class="breakfast-location__disclaimer">
          Top Notch Breakfast Restaurant and Wiarton Willys Inn are separate businesses.
        </p>
      </div>

      <div class="breakfast-location__actions">
        <a class="btn btn-primary" href={topNotchBreakfastMapsUrl} target="_blank" rel="noopener noreferrer" data-track="top-notch-breakfast-directions">Get Directions</a>
        <a class="btn btn-secondary" href={topNotchBreakfastPhone} data-track="call">Call Top Notch</a>
      </div>
    </div>
  </section>

  <div class="breakfast-mobile-cta" aria-label="Top Notch Breakfast Restaurant quick actions">
    <a href={topNotchBreakfastPhone} data-track="call">Call</a>
    <a href={topNotchBreakfastMapsUrl} target="_blank" rel="noopener noreferrer" data-track="top-notch-breakfast-directions">Directions</a>
  </div>
</BaseLayout>

<style>
  .breakfast-hero {
    position: relative;
    min-height: min(760px, 82vh);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #162d29;
    color: white;
  }

  .breakfast-hero__image,
  .breakfast-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .breakfast-hero__image {
    object-fit: cover;
    object-position: center;
  }

  .breakfast-hero__shade {
    background:
      linear-gradient(90deg, rgba(8, 24, 21, 0.9) 0%, rgba(8, 24, 21, 0.68) 43%, rgba(8, 24, 21, 0.12) 78%),
      linear-gradient(0deg, rgba(8, 24, 21, 0.72), transparent 58%);
  }

  .breakfast-hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(6rem, 14vw, 9rem);
    padding-bottom: clamp(3.2rem, 8vw, 5.5rem);
  }

  .breakfast-hero__content > * {
    max-width: 700px;
  }

  .breakfast-hero .eyebrow {
    color: #f3d596;
  }

  .breakfast-hero__badge {
    display: inline-flex;
    margin: 0 0 1rem;
    padding: 0.48rem 0.82rem;
    border-radius: 999px;
    background: rgba(215, 25, 32, 0.94);
    color: white;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .breakfast-hero h1 {
    max-width: 800px;
    color: white;
    font-size: clamp(3.2rem, 8vw, 6.5rem);
    text-shadow: 0 8px 35px rgba(0, 0, 0, 0.24);
    text-wrap: balance;
  }

  .breakfast-hero .lead {
    max-width: 650px;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
  }

  .breakfast-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    margin: 1.3rem 0 0;
  }

  .breakfast-hero__facts a {
    color: white;
    font-weight: 850;
    text-decoration-color: rgba(255,255,255,.5);
  }

  .breakfast-hero__button {
    border-color: rgba(255,255,255,.5);
    color: white;
    background: rgba(255,255,255,.1);
  }

  .breakfast-hero__note {
    margin-top: 1rem;
    color: rgba(255,255,255,.72);
    font-size: 0.86rem;
  }

  .breakfast-story {
    background: var(--color-cream);
  }

  .breakfast-story__grid,
  .breakfast-character__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .breakfast-story__copy p:not(.eyebrow),
  .breakfast-character__copy p:not(.eyebrow) {
    max-width: 650px;
  }

  .breakfast-photo {
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    background: #d7c8ae;
  }

  .breakfast-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .breakfast-photo--large {
    aspect-ratio: 16 / 9;
  }

  .breakfast-features {
    background: #fffdf8;
  }

  .breakfast-features__heading,
  .breakfast-menu__heading,
  .breakfast-artwork__heading,
  .breakfast-gallery__heading {
    max-width: 760px;
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }

  .breakfast-feature-grid {
    display: grid;
    gap: 1.25rem;
  }

  .breakfast-feature {
    overflow: hidden;
    border: 1px solid rgba(17,25,23,.1);
    border-radius: var(--radius-lg);
    background: var(--color-cream-light);
    box-shadow: var(--shadow-card);
  }

  .breakfast-feature img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .breakfast-feature > div {
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }

  .breakfast-feature h3 {
    margin-bottom: .6rem;
    color: var(--color-forest);
  }

  .breakfast-feature p:last-child {
    color: var(--color-muted);
  }

  .breakfast-character {
    background:
      radial-gradient(circle at 10% 20%, rgba(196,154,66,.12), transparent 24rem),
      var(--color-forest-dark);
    color: white;
  }

  .breakfast-character h2,
  .breakfast-character h3 {
    color: white;
  }

  .breakfast-character .eyebrow {
    color: #f3d596;
  }

  .breakfast-character__copy p:not(.eyebrow) {
    color: rgba(255,255,255,.82);
  }

  .breakfast-character__retro,
  .breakfast-character__history {
    aspect-ratio: 16 / 9;
  }

  .breakfast-menu {
    background: var(--color-cream);
  }

  .breakfast-menu-grid {
    display: grid;
    gap: 1rem;
  }

  .breakfast-menu-card {
    padding: clamp(1.2rem, 3vw, 1.75rem);
    border: 1px solid rgba(17,25,23,.1);
    border-radius: 18px;
    background: rgba(255,253,248,.96);
    box-shadow: var(--shadow-card);
  }

  .breakfast-menu-card h3 {
    margin-bottom: .85rem;
    color: var(--color-rust-dark);
    font-family: var(--font-heading);
    font-size: 1.5rem;
  }

  .breakfast-menu-card ul {
    display: grid;
    gap: .62rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .breakfast-menu-card li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .9rem;
    align-items: baseline;
    padding-bottom: .55rem;
    border-bottom: 1px dotted rgba(17,25,23,.22);
  }

  .breakfast-menu-card li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .breakfast-menu-card li span {
    color: var(--color-forest-dark);
    font-weight: 750;
  }

  .breakfast-menu-card li strong {
    color: var(--color-rust-dark);
    white-space: nowrap;
  }

  .breakfast-menu-note {
    margin-top: 1.2rem;
    padding: 1rem 1.15rem;
    border-left: 4px solid var(--color-rust);
    background: rgba(255,253,248,.78);
    color: var(--color-muted);
  }

  .breakfast-artwork {
    background: #fffdf8;
  }

  .breakfast-artwork__grid {
    display: grid;
    gap: 1.2rem;
  }

  .breakfast-menu-poster {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(17,25,23,.12);
    border-radius: 18px;
    background: var(--color-cream);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .breakfast-menu-poster:hover,
  .breakfast-menu-poster:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .breakfast-menu-poster img {
    width: 100%;
    height: auto;
  }

  .breakfast-menu-poster span {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: .9rem 1rem;
    color: var(--color-forest-dark);
    font-weight: 900;
  }

  .breakfast-menu-poster b {
    color: var(--color-rust-dark);
    font-size: .88rem;
  }

  .breakfast-gallery {
    background: var(--color-cream);
  }

  .breakfast-gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
  }

  .breakfast-gallery__grid img {
    width: 100%;
    height: 100%;
    min-height: 180px;
    object-fit: cover;
    border-radius: 14px;
  }

  .breakfast-gallery__grid img:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 8;
  }

  .breakfast-location {
    padding-bottom: clamp(6rem, 10vw, 8rem);
    background: #fffdf8;
  }

  .breakfast-location__card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgba(17,25,23,.1);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 90% 10%, rgba(196,154,66,.14), transparent 20rem),
      var(--color-cream-light);
    box-shadow: var(--shadow-soft);
  }

  .breakfast-location__details {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1.2rem;
    margin-top: 1rem;
    color: var(--color-rust-dark);
  }

  .breakfast-location__disclaimer {
    margin-top: .8rem;
    color: var(--color-muted);
    font-size: .86rem;
  }

  .breakfast-location__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .breakfast-mobile-cta {
    position: fixed;
    z-index: 60;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .65rem;
    padding: .75rem max(.85rem, env(safe-area-inset-right)) calc(.75rem + env(safe-area-inset-bottom)) max(.85rem, env(safe-area-inset-left));
    border-top: 1px solid rgba(255,255,255,.18);
    background: rgba(20, 49, 43, .96);
    backdrop-filter: blur(12px);
  }

  .breakfast-mobile-cta a {
    min-height: 46px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: white;
    color: var(--color-forest-dark);
    font-weight: 900;
    text-decoration: none;
  }

  .breakfast-mobile-cta a:last-child {
    background: var(--color-rust);
    color: white;
  }

  @media (min-width: 700px) {
    .breakfast-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .breakfast-menu-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .breakfast-artwork__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }

    .breakfast-gallery__grid {
      grid-template-columns: 1.2fr .8fr .8fr;
      grid-auto-rows: 220px;
    }

    .breakfast-gallery__grid img:first-child {
      grid-column: auto;
      grid-row: span 2;
      aspect-ratio: auto;
