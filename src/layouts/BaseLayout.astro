---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileStickyCTA from "../components/MobileStickyCTA.astro";
import SEOHead from "../components/SEOHead.astro";
import DinnerPromo from "../components/DinnerPromo.astro";
import { siteConfig } from "../data/siteConfig.js";
import "../styles/global.css";

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image,
  ogTitle,
  ogDescription,
  schema = [],
  pageType = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      schema={schema}
    />
  </head>
  <body data-page-type={pageType}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {pageType === "home" && <DinnerPromo />}
    <Footer />
    <MobileStickyCTA />

    {pageType === "home" && (
      <script is:inline>
        const dinnerPromo = document.querySelector(".dinner-promo-shell");
        const homepageHero = document.querySelector("main > .hero");
        const quickValue = document.querySelector("main > .quick-value");
        if (dinnerPromo && homepageHero) {
          homepageHero.insertAdjacentElement("afterend", dinnerPromo);
          quickValue?.classList.add("dinner-promo-following");
        }
      </script>
    )}

    <script is:inline define:vars={{ gaId: siteConfig.gaId }}>
      const sendTrackingEvent = (eventName, params = {}) => {
        if (typeof window.gtag === "function") {
          window.gtag("event", eventName, params);
        }
      };

      const pageType = document.body.dataset.pageType;
      if (pageType) {
        sendTrackingEvent(`${pageType}_page_visit`, {
          page_path: window.location.pathname,
        });
      }

      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target.closest("[data-track]") : null;
        if (!target) return;
        const trackName = target.getAttribute("data-track");
        const href = target instanceof HTMLAnchorElement ? target.href : "";
        const eventMap = {
          "book-direct": "book_direct_click",
          call: "call_tap",
          email: "email_click",
          "mobile-sticky-book": "mobile_sticky_book_click",
          "mobile-sticky-call": "mobile_sticky_call_click",
          "long-term-call": "long_term_stay_call_click",
          "dinner-menu": "dinner_menu_click",
          "top-notch-call": "top_notch_call_click",
          "top-notch-directions": "top_notch_directions_click",
        };
        const eventName = eventMap[trackName] || trackName;
        sendTrackingEvent(eventName, {
          link_url: href,
          page_path: window.location.pathname,
          channex_outbound: href.includes("ibe.channex.io") ? "true" : "false",
          ga_enabled: gaId ? "true" : "false",
        });
      });
    </script>
  </body>
</html>
