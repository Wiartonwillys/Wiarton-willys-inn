---
const {
  href,
  variant = "primary",
  class: className = "",
  dataTrack,
  external = false,
  ariaLabel,
  type = "button",
} = Astro.props;

const classes = ["btn", `btn-${variant}`, className].filter(Boolean).join(" ");
const rel = external ? "noopener noreferrer" : undefined;
---

{href ? (
  <a class={classes} href={href} rel={rel} aria-label={ariaLabel} data-track={dataTrack}>
    <slot />
  </a>
) : (
  <button class={classes} type={type} aria-label={ariaLabel} data-track={dataTrack}>
    <slot />
  </button>
)}
