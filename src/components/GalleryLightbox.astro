---

<div class="lightbox" data-lightbox hidden aria-modal="true" role="dialog" aria-label="Photo viewer">
  <div class="lightbox__panel">
    <button class="lightbox__button lightbox__close" type="button" aria-label="Close photo viewer" data-lightbox-close>×</button>
    <button class="lightbox__button lightbox__prev" type="button" aria-label="Previous photo" data-lightbox-prev>‹</button>
    <img class="lightbox__image" src="/images/global/default-placeholder/placeholder.svg" alt="" data-lightbox-image />
    <button class="lightbox__button lightbox__next" type="button" aria-label="Next photo" data-lightbox-next>›</button>
    <p class="lightbox__caption" data-lightbox-caption></p>
  </div>
</div>
