---
const { title, bestFor, detail, href, button, track, external = false } = Astro.props;
---

<article class="contact-card">
  <h3>{title}</h3>
  <p><strong>Best for:</strong> {bestFor}</p>
  <p>{detail}</p>
  <div>
    <a class="btn btn-secondary" href={href} rel={external ? "noopener noreferrer" : undefined} data-track={track}>{button}</a>
  </div>
</article>
