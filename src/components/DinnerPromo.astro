---
const topNotchPhoneDisplay = "(519) 534-1310";
const topNotchPhoneHref = "tel:+15195341310";
const topNotchMapsUrl = "https://www.google.com/maps/search/?api=1&query=Top%20Notch%20Motel%20%26%20Restaurant%2C%2010171%20Highway%206%2C%20Wiarton%2C%20Ontario";
const menuArtwork = "/images/dinner-menu/top-notch-indian-dinner-menu.svg";
---

<section class="dinner-promo-shell" aria-labelledby="dinner-promo-title">
  <div class="container">
    <article class="dinner-promo">
      <p class="dinner-promo__label">Featured local dinner from Top Notch Motel &amp; Restaurant</p>

      <div class="dinner-promo__layout">
        <div class="dinner-promo__copy">
          <span class="dinner-promo__badge">Takeout Only</span>
          <h2 id="dinner-promo-title">Weekend Indian-Style Dinner Takeout</h2>

          <a
            class="dinner-promo__address"
            href={topNotchMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="top-notch-directions"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
              <path d="M12 22s7-6.2 7-13a7 7 0 1 0-14 0c0 6.8 7 13 7 13Zm0-9.5A3.5 3.5 0 1 1 12 5a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"></path>
            </svg>
            <span>10171 Highway 6, Wiarton, Ontario</span>
          </a>

          <p class="dinner-promo__pickup">
            <strong>Pickup is at Top Notch Motel &amp; Restaurant</strong> — not at Wiarton Willys Inn.
          </p>

          <div class="dinner-promo__schedule" aria-label="Dinner service hours">
            <span>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21">
                <path d="M7 2v3M17 2v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
              Friday • Saturday • Sunday
            </span>
            <span>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
              5:00 PM – 11:00 PM
            </span>
          </div>

          <p class="dinner-promo__description">
            Enjoy Indian dinner combos, extra naan, and Indian fusion poutines — perfect for an easy weekend takeout meal.
          </p>

          <p class="dinner-promo__price">Dinner combos from $18.99 <span aria-hidden="true">•</span> Poutines from $14.99</p>

          <div class="dinner-promo__actions">
            <a class="btn btn-primary" href="/dinner-menu" data-track="dinner-menu">View Dinner Menu</a>
            <a
              class="btn btn-secondary"
              href={topNotchMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track="top-notch-directions"
            >
              Get Directions
            </a>
            <a class="dinner-promo__call" href={topNotchPhoneHref} data-track="top-notch-call">
              <span>Call to Order</span>
              <strong>{topNotchPhoneDisplay}</strong>
            </a>
          </div>
        </div>

        <a class="dinner-promo__art" href="/dinner-menu" data-track="dinner-menu" aria-label="View the full Top Notch dinner menu">
          <img src={menuArtwork} alt="Top Notch Indian Style Dinner takeout menu preview" loading="lazy" />
          <span>View the Full Dinner Menu <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .dinner-promo-shell {
    position: relative;
    z-index: 5;
    margin-top: -3.4rem;
    padding-bottom: clamp(1.35rem, 3vw, 2rem);
  }

  .dinner-promo {
    position: relative;
    overflow: hidden;
    padding: clamp(1.15rem, 3vw, 2rem);
    border: 1px solid rgba(17, 25, 23, 0.13);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(215, 25, 32, 0.045), transparent 42%),
      rgba(255, 253, 248, 0.98);
    box-shadow: var(--shadow-soft);
  }

  .dinner-promo::before {
    position: absolute;
    inset: 0 0 auto;
    height: 5px;
    background: linear-gradient(90deg, var(--color-rust), var(--color-gold), var(--color-forest));
    content: "";
  }

  .dinner-promo__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin: 0 0 clamp(1rem, 2.5vw, 1.5rem);
    color: var(--color-rust-dark);
    font-size: clamp(0.72rem, 1.5vw, 0.86rem);
    font-weight: 900;
    letter-spacing: 0.07em;
    text-align: center;
    text-transform: uppercase;
  }

  .dinner-promo__label::before,
  .dinner-promo__label::after {
    width: min(11vw, 7rem);
    height: 1px;
    background: rgba(159, 19, 24, 0.36);
    content: "";
  }

  .dinner-promo__layout {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.2rem);
    align-items: stretch;
  }

  .dinner-promo__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .dinner-promo__badge {
    display: inline-flex;
    margin-bottom: 0.85rem;
    padding: 0.38rem 0.8rem;
    border-radius: 999px;
    background: var(--color-rust-dark);
    color: var(--color-cream-light);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dinner-promo h2 {
    max-width: 680px;
    margin-bottom: 1rem;
    color: var(--color-forest);
    font-size: clamp(2rem, 5vw, 3.35rem);
  }

  .dinner-promo__address {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-rust-dark);
    font-size: clamp(1rem, 2vw, 1.18rem);
    font-weight: 900;
  }

  .dinner-promo__address svg {
    flex: 0 0 auto;
  }

  .dinner-promo__pickup {
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.93rem;
  }

  .dinner-promo__pickup strong {
    color: var(--color-text);
  }

  .dinner-promo__schedule {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    width: 100%;
    margin: 1.1rem 0;
    padding-block: 0.9rem;
    border-block: 1px solid rgba(17, 25, 23, 0.11);
  }

  .dinner-promo__schedule span {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: var(--color-forest-dark);
    font-weight: 850;
  }

  .dinner-promo__description {
    max-width: 650px;
    color: var(--color-text);
    font-size: clamp(1rem, 1.8vw, 1.12rem);
  }

  .dinner-promo__price {
    margin-top: 0.8rem;
    color: var(--color-rust-dark);
    font-family: var(--font-heading);
    font-size: clamp(1.04rem, 2vw, 1.25rem);
    font-weight: 800;
  }

  .dinner-promo__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  .dinner-promo__call {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 1rem;
    border: 1px solid rgba(32, 63, 50, 0.34);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    color: var(--color-forest);
    font-weight: 850;
    text-decoration: none;
  }

  .dinner-promo__call strong {
    color: var(--color-rust-dark);
  }

  .dinner-promo__call:hover {
    border-color: var(--color-rust);
    background: #fff;
  }

  .dinner-promo__art {
    position: relative;
    display: block;
    min-height: 360px;
    overflow: hidden;
    border: 1px solid rgba(159, 19, 24, 0.2);
    border-radius: 18px;
    background: #efe4d1;
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .dinner-promo__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    transition: transform 220ms ease;
  }

  .dinner-promo__art > span {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.8rem 1rem;
    background: rgba(159, 19, 24, 0.95);
    color: #fff;
    font-weight: 900;
    text-align: center;
  }

  .dinner-promo__art:hover img {
    transform: scale(1.025);
  }

  .dinner-promo__art:hover > span {
    background: var(--color-rust);
  }

  :global(.quick-value.dinner-promo-following) {
    margin-top: 0;
    padding-top: 0.4rem;
  }

  @media (min-width: 900px) {
    .dinner-promo__layout {
      grid-template-columns: minmax(0, 1.25fr) minmax(310px, 0.75fr);
    }

    .dinner-promo__art {
      min-height: 100%;
      max-height: 520px;
    }
  }

  @media (max-width: 620px) {
    .dinner-promo-shell {
      margin-top: -2rem;
    }

    .dinner-promo {
      padding: 1rem;
      border-radius: 18px;
    }

    .dinner-promo__label::before,
    .dinner-promo__label::after {
      display: none;
    }

    .dinner-promo__schedule {
      display: grid;
    }

    .dinner-promo__actions {
      display: grid;
      width: 100%;
    }

    .dinner-promo__actions .btn,
    .dinner-promo__call {
      width: 100%;
    }

    .dinner-promo__call {
      justify-content: center;
    }

    .dinner-promo__art {
      min-height: 330px;
    }
  }
</style>
